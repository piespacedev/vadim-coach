# Скопируйте в .env.local и заполните (локально он уже заполнен).
# На VPS те же настройки — в /opt/vadim-bot/.env (см. README, раздел «Бот на VPS»).

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Порт бота на VPS (nginx проксирует на него /api/lead).
PORT=3300

# Версия IP для запросов к Telegram: на VPS — 6 (по IPv4 api.telegram.org оттуда недоступен).
# Локально оставьте пустым.
TELEGRAM_IP_FAMILY=
